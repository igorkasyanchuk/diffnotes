{
  "name": "diffnotes",
  "version": "1.8.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev:server & vite",
    "dev:server": "PORT=3000 node --watch --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "build": "vite build",
    "image": "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/igorkasyanchuk/diffnotes:$npm_package_version -t ghcr.io/igorkasyanchuk/diffnotes:latest --push .",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "reset-password": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/reset-password.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "21.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
