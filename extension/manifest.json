{
  "manifest_version": 3,
  "name": "Reviews42",
  "version": "0.1.0",
  "description": "Shows your team's Reviews42 annotations on GitHub pull requests.",
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "Reviews42" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["markdown.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
